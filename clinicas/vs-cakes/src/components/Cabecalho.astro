---
import Marca from "./Marca.astro";

const atual = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/bolos", texto: "Bolos" },
  { href: "/bento", texto: "Bentô cakes" },
  { href: "/casamentos-e-eventos", texto: "Casamentos e eventos" },
  { href: "/datas-especiais", texto: "Datas especiais" },
  { href: "/como-encomendar", texto: "Como encomendar" },
  { href: "/sobre", texto: "Sobre" },
];
const ativo = (href: string) => atual === href;
---

<header class="topo">
  <div class="envolve barra">
    <a class="logo" href="/"><Marca /></a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={ativo(l.href) ? "page" : undefined}>
                {l.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="botao botao--rosa cta" href="/encomendar">Encomendar</a>

    <details class="menu">
      <summary aria-label="Abrir o menu">
        <span class="risco" aria-hidden="true"></span>
        <span class="so-leitor">Menu</span>
      </summary>
      <div class="gaveta">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={ativo(l.href) ? "page" : undefined}>
                  {l.texto}
                </a>
              </li>
            ))
          }
          <li><a class="botao botao--rosa" href="/encomendar">Encomendar</a></li>
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--marmore) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    view-transition-name: topo;
  }
  @supports (animation-timeline: scroll()) {
    .topo {
      animation: linha-topo linear both;
      animation-timeline: scroll();
      animation-range: 0 120px;
    }
    @keyframes linha-topo {
      to {
        border-bottom-color: color-mix(in oklab, var(--marinho) 14%, transparent);
        box-shadow: 0 18px 30px -26px rgba(24, 38, 95, 0.45);
      }
    }
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 72px;
  }
  .logo {
    color: var(--marinho);
    text-decoration: none;
    margin-right: auto;
  }
  .nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 30px);
  }
  .nav a {
    position: relative;
    display: inline-block;
    padding: 10px 0;
    text-decoration: none;
    font-weight: 560;
    font-size: 1rem;
    color: var(--tinta);
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 3px;
    border-radius: 3px;
    background: var(--rosa);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s;
  }
  .nav a:hover::after,
  .nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .cta {
    min-height: 46px;
    padding: 0 22px;
    font-size: 1rem;
  }
  .menu {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav,
    .cta {
      display: none;
    }
    .menu {
      display: block;
      position: relative;
    }
    .menu summary {
      list-style: none;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--marinho);
      cursor: pointer;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .risco,
    .risco::before,
    .risco::after {
      display: block;
      width: 20px;
      height: 2.5px;
      border-radius: 2px;
      background: var(--creme);
      content: "";
      position: relative;
    }
    .risco::before {
      position: absolute;
      top: -7px;
    }
    .risco::after {
      position: absolute;
      top: 7px;
    }
    .menu[open] .risco {
      background: transparent;
    }
    .menu[open] .risco::before {
      top: 0;
      rotate: 45deg;
    }
    .menu[open] .risco::after {
      top: 0;
      rotate: -45deg;
    }
    .gaveta {
      position: absolute;
      right: 0;
      top: 60px;
      width: min(86vw, 340px);
      padding: 14px;
      border-radius: 24px;
      background: var(--marinho);
      box-shadow: 0 30px 60px -24px rgba(24, 38, 95, 0.55);
    }
    .gaveta ul {
      display: grid;
      gap: 2px;
    }
    .gaveta a:not(.botao) {
      display: block;
      padding: 13px 16px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 600;
      color: var(--creme-claro);
    }
    .gaveta a:not(.botao):hover,
    .gaveta a[aria-current="page"] {
      background: color-mix(in oklab, var(--creme) 14%, transparent);
    }
    .gaveta .botao {
      width: 100%;
      margin-top: 8px;
    }
  }
</style>
