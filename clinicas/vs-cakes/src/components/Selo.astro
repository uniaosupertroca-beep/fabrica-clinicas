---
// Selo circular com o nome, como o que ela usa na capa do cardápio. Decorativo.
interface Props {
  class?: string;
}
const { class: classe } = Astro.props;
---

<svg class={classe} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <defs>
    <path id="selo-curva" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" />
  </defs>
  <circle cx="100" cy="100" r="98" fill="currentColor" opacity="0.0" />
  <text font-family="Fraunces, Georgia, serif" font-weight="700" font-size="17" fill="currentColor" style="font-variation-settings:'SOFT' 100">
    <textPath href="#selo-curva" textLength="458" lengthAdjust="spacing">vs cakes · vanessa soares · itajaí · </textPath>
  </text>
  <text x="100" y="124" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="820" font-size="66" fill="currentColor" style="font-variation-settings:'SOFT' 100,'WONK' 1;letter-spacing:-0.03em">VS</text>
</svg>
