---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import Selo from "../components/Selo.astro";
import Ampliar from "../components/Ampliar.astro";
import Lightbox from "../components/Lightbox.astro";
import { negocio, linkWhatsapp, mensagemPadrao } from "../data/site.ts";
import { ocasioes } from "../data/ocasioes.ts";
import { datas } from "../data/datas.ts";
import { tamanhos, sabores } from "../data/cardapio.ts";
import { foto } from "../data/galeria.ts";

// A vitrine da abertura: bolos vintage e florais, um de cada vez.
const vitrine = ["vintage-cerejas", "coracao-vintage", "mesversario-lacos", "rosas-amarelas"];
// Fotos em que o bolo aparece pequeno no quadro ganham zoom, para preencher o arco.
const zoom: Record<string, number> = { "coracao-vintage": 1.6 };
// Colagem de bolos, com proporções diferentes de propósito (vira uma parede de fotos, não uma grade).
const colagem: { id: string; proporcao: string }[] = [
  { id: "floral-gerberas", proporcao: "3 / 4" },
  { id: "bolo-tematico", proporcao: "1 / 1" },
  { id: "rosas-amarelas", proporcao: "4 / 5" },
  { id: "mini-bolos-casamento", proporcao: "1 / 1" },
  { id: "folhas-laranja", proporcao: "3 / 4" },
  { id: "bento-namorados", proporcao: "4 / 5" },
  { id: "casamento-duas-camadas", proporcao: "4 / 5" },
  { id: "guirlanda-brownie", proporcao: "1 / 1" },
  { id: "margaridas", proporcao: "4 / 5" },
];
const passos = [
  { titulo: "Escolha o tamanho e o sabor", texto: `Do ${tamanhos[0].nome} ao ${tamanhos[tamanhos.length - 1].nome}, com ${sabores.length} sabores no cardápio.` },
  { titulo: "Conte a decoração", texto: "Tema, paleta de cores e o que torna o momento especial. Referências são bem-vindas." },
  { titulo: "Combine a data", texto: `Encomendas com pelo menos ${negocio.prazoMinimoDias} dias de antecedência, com retirada agendada ou entrega.` },
  { titulo: "Pague 50% e retire", texto: "50% na encomenda e 50% na retirada, por Pix, dinheiro ou link de pagamento." },
];
---

<Base
  titulo="VS Cakes | Bolos personalizados, bentô cakes e docinhos em Itajaí"
  descricao="Bolos com sabor de afeto, feitos à mão pela Vanessa em Itajaí (SC): bolos vintage e personalizados, bentô cakes, mini bolos, docinhos e mesas para casamentos e eventos."
  comDadosEstruturados
>
  <section class="hero">
    <div class="envolve grade">
      <div class="texto">
        <h1>
          <span class="linha"><span>Bolos</span></span>
          <span class="linha"><span>com sabor</span></span>
          <span class="linha"><span>de afeto.</span></span>
        </h1>
        <p class="mao assina">feitos à mão em {negocio.cidade}</p>
        <p class="abre apoio">
          Bolos personalizados, bentô cakes e docinhos pela Vanessa. Você conta o momento; a gente cuida de cada detalhe.
        </p>
        <div class="acoes apoio">
          <a class="botao" href="/encomendar">Montar meu pedido</a>
          <a class="botao botao--linha" href="/bolos">Ver os bolos</a>
        </div>
        <p class="fato apoio">Encomendas com {negocio.prazoMinimoDias} dias de antecedência. Retirada agendada ou entrega.</p>
      </div>

      <div class="vitrine">
        <div class="arco-moldura">
          <div class="arco janela">
            {
              vitrine.map((id, i) => (
                <div class="slide" style={`--i:${i};--zoom:${zoom[id] ?? 1}`}>
                  <Foto
                    id={id}
                    proporcao="3 / 4"
                    sizes="(min-width: 980px) 38vw, 80vw"
                    widths={[480, 720, 960, 1200]}
                    carregar={i === 0 ? "eager" : "lazy"}
                    alt={i === 0 ? undefined : ""}
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="selo-caixa"><Selo class="selo" /></div>
      </div>
    </div>
  </section>

  <section class="secao momentos fundo-marmore-2 bico" aria-labelledby="t-momentos">
    <div class="envolve">
      <div class="cabeca">
        <h2 id="t-momentos">Para qual momento?</h2>
        <p class="abre">Cada celebração pede um bolo diferente. Escolha por onde começar.</p>
      </div>
      <ul class="paineis">
        {
          ocasioes.map((o) => (
            <li>
              <a class="painel" href={o.href}>
                <div class="arco-moldura">
                  <Foto id={o.foto} proporcao="3 / 4" class="arco" sizes="(min-width: 1100px) 22vw, (min-width: 640px) 40vw, 70vw" widths={[360, 560, 800]} alt="" />
                </div>
                <span class="painel-titulo">{o.titulo}</span>
                <span class="painel-p">{o.texto}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao vintage fundo-marinho padrao bico" aria-labelledby="t-vintage">
    <div class="envolve grade-vintage">
      <div class="texto">
        <p class="mao">bico, laços e frases à mão</p>
        <h2 id="t-vintage">O bolo vintage é a cara da VS Cakes.</h2>
        <p class="abre">
          Acabamento todo à mão, cores que combinam com a sua festa e uma frase só sua. Você traz a ideia, a Vanessa transforma em bolo: delicado por fora e irresistível por dentro.
        </p>
        <div class="acoes">
          <a class="botao botao--rosa" href="/bolos#vintage">Ver os bolos vintage</a>
        </div>
      </div>
      <div class="composicao">
        <Foto id="vintage-cerejas" proporcao="3 / 4" class="arco grande" sizes="(min-width: 980px) 30vw, 70vw" widths={[420, 640, 900]} />
        <Foto id="coracao-preto" proporcao="1 / 1" class="redonda sobe" sizes="(min-width: 980px) 16vw, 36vw" widths={[240, 400, 600]} />
        <Foto id="natal-vintage" proporcao="4 / 5" class="pequena desce" sizes="(min-width: 980px) 16vw, 34vw" widths={[240, 400, 600]} />
      </div>
    </div>
  </section>

  <section class="secao colagem-secao" aria-labelledby="t-previa">
    <div class="envolve">
      <div class="cabeca">
        <h2 id="t-previa">Alguns bolos que a Vanessa fez.</h2>
        <a class="botao botao--linha" href="/bolos">Ver todos os bolos</a>
      </div>
      <p class="dica">Toque em uma foto para ver maior e pedir um bolo assim.</p>
      <ul class="colagem">
        {
          colagem.map((c) => (
            <li>
              <Ampliar id={c.id} proporcao={c.proporcao} sizes="(min-width: 1100px) 28vw, (min-width: 640px) 32vw, 46vw" widths={[320, 520, 760]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao como fundo-marmore-2 bico" aria-labelledby="t-como">
    <div class="envolve">
      <div class="cabeca">
        <h2 id="t-como">Encomendar é simples.</h2>
        <p class="abre">Do primeiro recado até a retirada, a Vanessa acompanha cada passo pelo WhatsApp.</p>
      </div>
      <ol class="passos">
        {
          passos.map((p, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <div class="acoes">
        <a class="botao" href="/encomendar">Montar meu pedido</a>
        <a class="botao botao--linha" href="/como-encomendar">Ler todas as regras</a>
      </div>
    </div>
  </section>

  <section class="secao vanessa fundo-rosa bico" aria-labelledby="t-vanessa">
    <div class="envolve grade-vanessa">
      <div class="retrato-caixa">
        <div class="arco-moldura">
          <Foto id="vanessa:retrato" proporcao="4 / 5" class="arco retrato" sizes="(min-width: 980px) 36vw, 88vw" widths={[480, 760, 1040]} />
        </div>
        <Foto id="vanessa:bico" proporcao="1 / 1" class="redonda detalhe" sizes="(min-width: 980px) 15vw, 34vw" widths={[260, 420, 640]} />
      </div>
      <div class="texto">
        <h2 id="t-vanessa">Olá, eu sou a Vanessa!</h2>
        <p class="abre">
          Sou formada em gastronomia e encontrei na confeitaria a forma mais genuína de expressar meu amor pela profissão.
        </p>
        <p>
          Foi esse amor que deu origem à VS Cakes, um espaço onde cada detalhe é pensado para entregar afeto em forma de sabor. Aqui, cada pedido carrega intenção, carinho e, acima de tudo, qualidade. Meu propósito é te proporcionar um momento especial, único, bonito e memorável: do jeito que ele merece ser lembrado.
        </p>
        <p class="assinatura mao" aria-label="Vanessa Soares">Vanessa Soares</p>
        <p class="anos">{negocio.anosDeMarca} anos adoçando momentos únicos.</p>
        <div class="acoes">
          <a class="botao botao--linha" href="/sobre">Conhecer a história</a>
          <a class="link-insta" href={negocio.instagramUrl} target="_blank" rel="noopener noreferrer">Ver os bastidores no Instagram</a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao datas" aria-labelledby="t-datas">
    <div class="envolve grade-datas">
      <div class="texto">
        <h2 id="t-datas">Uma data especial a cada estação.</h2>
        <p class="abre">A Vanessa lança um cardápio para cada data. Ele sai no Instagram e no WhatsApp, com o prazo de encomenda.</p>
        <div class="acoes">
          <a class="botao botao--linha" href="/datas-especiais">Ver como foram</a>
        </div>
      </div>
      <ul class="lista-datas">
        {
          datas.map((d) => (
            <li>
              <span class="data-nome">{d.nome}</span>
              <span class="data-quando">{d.quando}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao final fundo-marinho padrao bico" aria-labelledby="t-final">
    <div class="envolve grade-final">
      <div class="texto">
        <p class="mao">com carinho, VS Cakes</p>
        <h2 id="t-final">Vamos adoçar o seu momento?</h2>
        <p class="abre">Monte o pedido aqui e a mensagem chega pronta no WhatsApp da Vanessa. Ou chame direto: ela responde com o valor e a data disponível.</p>
        <div class="acoes">
          <a class="botao botao--rosa" href="/encomendar">Montar meu pedido</a>
          <a class="botao botao--linha" href={linkWhatsapp(mensagemPadrao)} target="_blank" rel="noopener noreferrer">Chamar no WhatsApp</a>
        </div>
      </div>
      <div class="trio" aria-hidden="true">
        <Foto id="bento-amigo" proporcao="3 / 4" class="arco a" sizes="(min-width: 980px) 18vw, 40vw" widths={[260, 420, 640]} alt="" />
        <Foto id="bento-pais-caixa" proporcao="3 / 4" class="arco b" sizes="(min-width: 980px) 18vw, 40vw" widths={[260, 420, 640]} alt="" />
      </div>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  /* Abertura: marmore, a vitrine em arco e o título que sobe linha a linha. */
  .hero {
    position: relative;
    margin-top: calc(var(--topo) * -1);
    padding-block: calc(var(--topo) + clamp(28px, 5vw, 64px)) clamp(72px, 9vw, 132px);
    background: var(--marmore) url("/marmore.webp") center top / cover no-repeat;
    overflow: hidden;
  }
  /* No celular a foto vem logo depois do título; no computador, ao lado do texto. */
  .grade {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero .texto {
    display: contents;
  }
  .hero h1 {
    order: 1;
    font-size: clamp(3.3rem, 15.5vw, 6.6rem);
    line-height: 0.93;
  }
  .assina {
    order: 2;
  }
  .vitrine {
    order: 3;
    margin-block: 8px 4px;
  }
  .hero .abre {
    order: 4;
  }
  .hero .acoes {
    order: 5;
  }
  .hero .fato {
    order: 6;
  }
  @media (min-width: 980px) {
    .grade {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      align-items: center;
      gap: clamp(36px, 5vw, 64px);
    }
    .hero .texto {
      display: block;
    }
    .hero .texto > * + * {
      margin-top: 26px;
    }
    .hero h1 {
      font-size: clamp(3.3rem, 1rem + 8.6vw, 8rem);
    }
    .vitrine {
      margin-block: 0;
    }
  }
  .linha {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .linha > span {
    display: block;
    animation: sobe-linha 1s cubic-bezier(0.2, 0.75, 0.15, 1) both;
  }
  .linha:nth-child(2) > span {
    animation-delay: 0.09s;
  }
  .linha:nth-child(3) > span {
    animation-delay: 0.18s;
  }
  @keyframes sobe-linha {
    from {
      translate: 0 108%;
    }
  }
  .assina {
    margin-top: 0;
    font-size: clamp(2.3rem, 1.6rem + 2.4vw, 3.6rem);
    color: var(--marinho);
    animation: aparece 1s ease 0.55s both;
  }
  .apoio {
    animation: aparece 1s ease 0.7s both;
  }
  @keyframes aparece {
    from {
      opacity: 0;
    }
  }
  .hero .abre {
    max-width: 34em;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .fato {
    padding-top: 6px;
    font-size: 0.975rem;
    color: var(--tinta-2);
  }

  .vitrine {
    position: relative;
    width: min(100%, 470px);
    justify-self: center;
    padding-right: 16px;
    padding-bottom: 16px;
  }
  .vitrine .arco-moldura::before {
    animation: aparece 1.1s ease 0.9s both;
  }
  .janela {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    box-shadow: var(--sombra-foto);
    animation: abre-arco 1.25s cubic-bezier(0.2, 0.75, 0.1, 1) 0.1s both;
  }
  @keyframes abre-arco {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Um bolo a cada 5 s. A primeira foto já nasce visível (atraso negativo), para o título não esperar. */
    animation: passa 20s linear infinite;
    animation-delay: calc(var(--i) * 5s - 1.2s);
  }
  .slide:first-child {
    opacity: 1;
  }
  .slide :global(.foto) {
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
  }
  .slide :global(img) {
    scale: var(--zoom, 1);
  }
  @keyframes passa {
    0% {
      opacity: 0;
      scale: 1;
    }
    6% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    31% {
      opacity: 0;
    }
    100% {
      opacity: 0;
      scale: 1.07;
    }
  }
  .selo-caixa {
    position: absolute;
    right: -6px;
    top: 2%;
    width: clamp(92px, 12vw, 124px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--rosa);
    color: var(--marinho);
    box-shadow: 0 18px 30px -16px rgba(24, 38, 95, 0.55);
    animation: gira 60s linear infinite;
  }
  .selo {
    width: 84%;
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }
  @media (max-width: 979px) {
    .vitrine {
      width: min(100%, 420px);
    }
  }

  /* Momentos */
  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 18px 40px;
  }
  .cabeca .abre {
    max-width: 30em;
  }
  .paineis {
    display: grid;
    gap: 22px;
    margin-top: clamp(36px, 5vw, 64px);
    grid-auto-flow: column;
    grid-auto-columns: 74%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--margem) * -1);
    padding: 4px var(--margem) 22px;
    scrollbar-width: none;
  }
  .paineis::-webkit-scrollbar {
    display: none;
  }
  .paineis > li {
    scroll-snap-align: center;
  }
  @media (min-width: 640px) {
    .paineis {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, 1fr);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
      gap: 40px 28px;
    }
  }
  @media (min-width: 1100px) {
    .paineis {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
    .paineis > li:nth-child(even) {
      margin-top: 56px;
    }
  }
  .painel {
    display: grid;
    gap: 6px;
    align-content: start;
    height: 100%;
    text-decoration: none;
  }
  .painel .arco-moldura {
    margin: 0 14px 14px 0;
    margin-bottom: 18px;
  }
  .painel .arco-moldura::before {
    translate: 0 0;
    transition: translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .painel:hover .arco-moldura::before,
  .painel:focus-visible .arco-moldura::before {
    translate: 14px 14px;
  }
  .painel :global(img) {
    transition: scale 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .painel:hover :global(img) {
    scale: 1.06;
  }
  .painel-titulo {
    font-family: var(--titulo);
    font-variation-settings: "SOFT" 100;
    font-weight: 580;
    font-size: 1.55rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--marinho);
  }
  .painel-p {
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--tinta-2);
  }

  /* Vintage */
  .grade-vintage {
    display: grid;
    gap: clamp(48px, 6vw, 84px);
    align-items: center;
  }
  @media (min-width: 980px) {
    .grade-vintage {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }
  .vintage .mao {
    margin-bottom: 14px;
  }
  .vintage .texto > * + * {
    margin-top: 24px;
  }
  .vintage .texto .mao + h2 {
    margin-top: 0;
  }
  .composicao {
    position: relative;
    width: min(100%, 520px);
    justify-self: center;
    padding: 0 0 clamp(48px, 7vw, 72px) clamp(36px, 8vw, 72px);
  }
  .composicao :global(.grande) {
    width: 100%;
    box-shadow: 0 40px 70px -36px rgba(0, 0, 0, 0.6);
  }
  .composicao :global(.redonda) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 40%;
    border-radius: 50%;
    border: 7px solid var(--marinho);
    box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.6);
  }
  .composicao :global(.pequena) {
    position: absolute;
    right: -4%;
    top: 4%;
    width: 31%;
    border-radius: 22px;
    border: 6px solid var(--marinho);
    box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.6);
    rotate: 4deg;
  }

  /* Colagem de bolos */
  .colagem-secao .cabeca {
    margin-bottom: 14px;
  }
  .dica {
    font-size: 0.95rem;
    color: var(--tinta-2);
  }
  .colagem {
    columns: 2;
    column-gap: 14px;
    margin-top: clamp(26px, 3.5vw, 42px);
  }
  @media (min-width: 700px) {
    .colagem {
      columns: 3;
      column-gap: 20px;
    }
  }
  .colagem li {
    break-inside: avoid;
    margin-bottom: 14px;
  }
  @media (min-width: 700px) {
    .colagem li {
      margin-bottom: 20px;
    }
  }
  @media (max-width: 699px) {
    .colagem li:nth-child(9) {
      display: none;
    }
    .colagem :global(.legenda) {
      display: none;
    }
  }
  .colagem :global(.foto) {
    border-radius: 24px;
    box-shadow: 0 22px 36px -28px rgba(24, 38, 95, 0.6);
  }

  /* Passos */
  .passos {
    position: relative;
    display: grid;
    gap: 34px;
    margin-block: clamp(40px, 5vw, 64px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .passos {
      grid-template-columns: repeat(2, 1fr);
      gap: 44px 40px;
    }
  }
  @media (min-width: 1100px) {
    .passos {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }
  .passos li {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 22px;
    border-top: 2px dotted color-mix(in oklab, var(--rosa) 90%, var(--marinho));
  }
  .num {
    font-family: var(--titulo);
    font-variation-settings: "SOFT" 100, "WONK" 0;
    font-weight: 300;
    font-size: clamp(4rem, 3rem + 3vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--marinho);
  }
  .passos p {
    color: var(--tinta-2);
    font-size: 1rem;
  }

  /* Vanessa */
  .grade-vanessa {
    display: grid;
