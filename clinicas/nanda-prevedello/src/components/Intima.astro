---
// Harmonização íntima: a especialidade da Dra. Nanda, numa seção escura e reservada. Três cartões
// (feminina, NinfoSlim e masculina) e, ao lado, como a clínica cuida da privacidade.
import type { NomeIcone } from "../data/icones.ts";
import { porCategoria } from "../data/tratamentos.ts";
import Icone from "./Icone.astro";

const privacidade: { icone: NomeIcone; texto: string }[] = [
  { icone: "conversa", texto: "Primeiro contato pelo WhatsApp, direto com a clínica" },
  { icone: "cadeado", texto: "Consulta individual, em sala reservada" },
  { icone: "escudo", texto: "Prontuário e informações protegidos, com sigilo" },
  { icone: "alerta", texto: "Nenhuma foto é usada ou divulgada sem a sua autorização por escrito" },
];
---

<section class="secao escura" id="intima" aria-labelledby="t-intima">
  <div class="envolve">
    <div class="cabeca">
      <div>
        <p class="chapeu">Harmonização íntima</p>
        <h2 class="titulo" id="t-intima">Um cuidado íntimo pede conversa reservada <em>e um plano feito só para você.</em></h2>
      </div>
      <p class="abre">
        Para mulheres e homens que querem mais conforto e confiança com a região íntima. Volume, contorno, firmeza e qualidade da pele,
        com técnicas escolhidas depois de uma avaliação individual e produtos registrados na Anvisa.
      </p>
    </div>

    <div class="corpo">
      <ul class="cartoes">
        {
          porCategoria("Íntima").map((t) => (
            <li>
              <a class="cartao" href={`/tratamentos/${t.slug}/`}>
                <span class="icone">
                  <Icone nome={t.icone} tamanho={26} traco={1.3} />
                </span>
                <h3>{t.nome}</h3>
                <p>{t.resumo}</p>
                <span class="mais">
                  Saiba mais
                  <Icone nome="seta" tamanho={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="reservado">
        <h3 id="t-reservado">Como cuidamos da sua privacidade</h3>
        <ul>
          {
            privacidade.map((p) => (
              <li>
                <Icone nome={p.icone} tamanho={20} traco={1.5} />
                {p.texto}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .escura {
    background:
      radial-gradient(50% 60% at 100% 0%, color-mix(in oklab, var(--acento) 12%, transparent), transparent 70%),
      var(--escuro);
  }
  .cabeca {
    display: grid;
    gap: 8px 72px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .cabeca {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .cabeca .abre {
      margin-top: 0;
    }
  }
  .corpo {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 1080px) {
    .corpo {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }
  .cartoes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    min-width: 0;
  }
  @media (min-width: 720px) {
    .cartoes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cartoes li {
    display: grid;
  }
  /* Cartões escuros com fio de ouro, que acendem ao passar o mouse. */
  .cartao {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 26px 24px;
    border: 1px solid color-mix(in oklab, var(--claro) 12%, transparent);
    border-radius: var(--raio);
    background: linear-gradient(180deg, var(--escuro-2), var(--escuro));
    color: var(--claro);
    text-decoration: none;
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }
  .cartao:hover {
    border-color: color-mix(in oklab, var(--acento) 70%, transparent);
  }
  .cartao .icone {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid color-mix(in oklab, var(--acento) 55%, transparent);
    color: var(--acento);
    rotate: 45deg;
    margin: 4px 0 6px 4px;
  }
  .cartao .icone :global(svg) {
    rotate: -45deg;
  }
  .cartao h3 {
    font-family: var(--fonte-titulo);
    font-size: clamp(21px, 6vw, 24px);
    hyphens: auto;
    font-weight: 400;
    line-height: 1.15;
  }
  .cartao p {
    font-size: 15px;
    color: var(--claro-2);
  }
  .mais {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--acento);
  }
  .reservado {
    padding: 30px 28px;
    border: 1px solid color-mix(in oklab, var(--acento) 40%, transparent);
    border-radius: var(--raio);
  }
  .reservado h3 {
    font-family: var(--fonte-titulo);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--acento-claro);
  }
  .reservado ul {
    list-style: none;
    padding: 0;
    margin-top: 22px;
    display: grid;
    gap: 16px;
  }
  .reservado li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    font-size: 15.5px;
    color: var(--claro-2);
  }
  .reservado :global(svg) {
    margin-top: 2px;
    color: var(--acento);
  }
</style>
