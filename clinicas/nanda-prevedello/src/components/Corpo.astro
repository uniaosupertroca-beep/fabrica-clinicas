---
// Corpo e contorno: o Lipolaser Slim explicado em quatro partes e, abaixo, os protocolos para o corpo.
import type { NomeIcone } from "../data/icones.ts";
import { porCategoria } from "../data/tratamentos.ts";
import CartaoTratamento from "./CartaoTratamento.astro";
import Icone from "./Icone.astro";

const partes: { icone: NomeIcone; titulo: string; texto: string }[] = [
  { icone: "laser", titulo: "Laser", texto: "Atua nas células de gordura e estimula a quebra dos depósitos." },
  { icone: "termometro", titulo: "Câmara termográfica", texto: "Acompanha a temperatura da pele no ponto que estimula colágeno e retração." },
  { icone: "bolhas", titulo: "Ozonioterapia", texto: "Melhora a oxigenação dos tecidos e diminui a inflamação." },
  { icone: "frasco", titulo: "Ativos personalizados", texto: "Aminoácidos e vitaminas escolhidos para a necessidade de cada pessoa." },
];
const corpo = porCategoria("Corpo").filter((t) => t.slug !== "lipolaser-slim");
---

<section class="secao suave" id="corpo" aria-labelledby="t-corpo">
  <div class="envolve">
    <div class="cabeca">
      <div>
        <p class="chapeu">Corpo e contorno</p>
        <h2 class="titulo" id="t-corpo">Para quem se cuida <em>e mantém a gordura que não sai.</em></h2>
      </div>
      <p class="abre">
        Protocolos minimamente invasivos, feitos na clínica, para gordura localizada, flacidez, contorno e lipedema. Sem promessa de milagre: o
        corpo responde no tempo dele, e a evolução é acompanhada em cada retorno.
      </p>
    </div>

    <article class="destaque" aria-labelledby="t-lipolaser">
      <div class="destaque-texto">
        <p class="rotulo">Protocolo em destaque</p>
        <h3 id="t-lipolaser">Lipolaser Slim</h3>
        <p>Quatro recursos numa mesma sessão, para a gordura localizada e a flacidez leve, com evolução progressiva ao longo das semanas.</p>
        <a class="botao escuro" href="/tratamentos/lipolaser-slim/">
          Como funciona o Lipolaser Slim
          <Icone nome="seta" tamanho={18} />
        </a>
      </div>
      <ol class="partes">
        {
          partes.map((p) => (
            <li>
              <span class="icone">
                <Icone nome={p.icone} tamanho={24} traco={1.4} />
              </span>
              <h4>{p.titulo}</h4>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </article>

    <ul class="grade">
      {
        corpo.map((t) => (
          <li>
            <CartaoTratamento nome={t.nome} resumo={t.resumo} href={`/tratamentos/${t.slug}/`} icone={t.icone} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cabeca {
    display: grid;
    gap: 8px 72px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .cabeca {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .cabeca .abre {
      margin-top: 0;
    }
  }

  /* O Lipolaser Slim em quatro partes, numa faixa branca com fio de ouro no topo. */
  .destaque {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    gap: 36px;
    padding: clamp(28px, 4vw, 48px);
    background: var(--branco);
    border: 1px solid var(--linha);
    border-top: 2px solid var(--acento);
    border-radius: var(--raio);
  }
  @media (min-width: 1000px) {
    .destaque {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 56px;
      align-items: center;
    }
  }
  .rotulo {
    font-size: 14px;
    font-weight: 600;
    color: var(--acento-texto);
  }
  .destaque h3 {
    margin-top: 8px;
    font-family: var(--fonte-titulo);
    font-size: clamp(34px, 4vw, 46px);
    font-weight: 400;
    line-height: 1.05;
  }
  .destaque-texto > p:not(.rotulo) {
    margin-top: 14px;
    color: var(--tinta-2);
  }
  .destaque .botao {
    margin-top: 26px;
  }
  .partes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 28px 32px;
    counter-reset: parte;
  }
  @media (min-width: 560px) {
    .partes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .partes li {
    padding-top: 18px;
    border-top: 1px solid var(--linha);
  }
  .partes .icone {
    display: inline-grid;
    color: var(--acento-texto);
  }
  .partes h4 {
    margin-top: 10px;
    font-family: var(--fonte-titulo);
    font-size: 21px;
    font-weight: 400;
  }
  .partes p {
    margin-top: 4px;
    font-size: 15.5px;
    color: var(--tinta-2);
  }

  .grade {
    list-style: none;
    padding: 0;
    margin-top: 16px;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .grade {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .grade li {
    display: grid;
  }
</style>
