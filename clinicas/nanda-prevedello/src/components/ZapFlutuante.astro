---
import { linkWhatsapp } from "../data/clinica.ts";
import Icone from "./Icone.astro";

interface Props {
  mensagem?: string;
}
const { mensagem } = Astro.props;
---

<a class="zap-flutuante" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener" aria-label="Agendar avaliação pelo WhatsApp">
  <Icone nome="whatsapp" tamanho={26} />
  <span>Agendar avaliação</span>
</a>

<style>
  .zap-flutuante {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    background: var(--zap);
    color: #fff;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    box-shadow:
      0 18px 40px -14px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: background-color 0.2s;
  }
  .zap-flutuante:hover {
    background: var(--zap-escuro);
  }
  span {
    display: none;
  }
  /* Aparece depois que a pessoa passa do topo (que já tem o botão), onde o navegador permite. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .zap-flutuante {
        animation: chega linear both;
      }
      /* Em regra separada (e mais específica): o minificador junta tudo num "animation" só,
         e o navegador descarta o shorthand com a linha do tempo dentro. */
      a.zap-flutuante {
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }
  @keyframes chega {
    0%,
    70% {
      opacity: 0;
      translate: 0 24px;
      visibility: hidden;
    }
    100% {
      opacity: 1;
      translate: none;
      visibility: visible;
    }
  }
  @media (min-width: 720px) {
    .zap-flutuante {
      width: auto;
      padding: 0 24px 0 18px;
      right: 24px;
      bottom: 24px;
    }
    span {
      display: inline;
    }
  }
</style>
