---
// Página de cada tratamento, gerada a partir de src/data/tratamentos.ts.
import Cabecalho from "../../components/Cabecalho.astro";
import CartaoTratamento from "../../components/CartaoTratamento.astro";
import Chamada from "../../components/Chamada.astro";
import Duvidas from "../../components/Duvidas.astro";
import Etapas from "../../components/Etapas.astro";
import Icone from "../../components/Icone.astro";
import Rodape from "../../components/Rodape.astro";
import Topo from "../../components/Topo.astro";
import ZapFlutuante from "../../components/ZapFlutuante.astro";
import { clinica, linkWhatsapp, mensagemPara, rotuloResponsavel } from "../../data/clinica.ts";
import { iconeDaEtapa, iconeDaFicha, nomeDaCategoria, porCategoria, type Tratamento, tratamentos } from "../../data/tratamentos.ts";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return tratamentos.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

interface Props {
  t: Tratamento;
}

const { t } = Astro.props;
const mensagem = mensagemPara(t.assunto);
const r = clinica.responsavel;
const relacionados = porCategoria(t.categoria).filter((x) => x.slug !== t.slug);
const etapas = t.etapas.map((e) => ({ ...e, icone: iconeDaEtapa(e.titulo, t) }));
---

<Base titulo={`${t.nome} em ${clinica.cidade} (${clinica.uf}) | Dra. Nanda Prevedello`} descricao={`${t.resumo} Avaliação individual com a Dra. Nanda Prevedello, em ${clinica.cidade} (${clinica.uf}).`}>
  <Topo interna />
  <main id="conteudo">
    <Cabecalho
      id="t-nome"
      trilha={{ href: "/tratamentos/", texto: "Tratamentos" }}
      chapeu={nomeDaCategoria[t.categoria]}
      titulo={`${t.nome},`}
      destaque={t.destaque}
      resumo={t.resumo}
      icone={t.icone}
      palavra={t.categoria === "Íntima" ? "Íntima" : t.categoria}
      foto={t.foto}
    >
      <a class="botao zap" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener">
        <Icone nome="whatsapp" tamanho={20} />
        Agendar avaliação
      </a>
      <a class="botao linha" href="/tratamentos/">Ver todos os tratamentos</a>
    </Cabecalho>

    <section class="secao suave" aria-labelledby="t-o-que-e">
      <div class="envolve grade">
        <div class="texto">
          <p class="chapeu">O tratamento</p>
          <h2 class="titulo" id="t-o-que-e">Como funciona <em>e para quem.</em></h2>
          <div class="corpo">
            {t.oQueE.map((par, i) => <p class:list={{ destaque: i === 0 }}>{par}</p>)}
          </div>
          <h3 class="subtitulo">Costuma ser procurado para</h3>
          <ul class="indicacoes">
            {
              t.indicacoes.map((item) => (
                <li>
                  <span class="visto">
                    <Icone nome="certo" tamanho={16} traco={2} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ficha">
          <h3>
            <Icone nome={t.icone} tamanho={22} />
            Em resumo
          </h3>
          <dl>
            {
              t.ficha.map((f) => (
                <div>
                  <dt>
                    <span class="ficha-icone">
                      <Icone nome={iconeDaFicha(f.termo, t)} tamanho={20} traco={1.5} />
                    </span>
                    {f.termo}
                  </dt>
                  <dd>{f.texto}</dd>
                </div>
              ))
            }
          </dl>
          <a class="botao zap" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener">
            <Icone nome="whatsapp" tamanho={18} />
            Tirar dúvidas no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <Etapas etapas={etapas} chapeu="Como é feito" titulo="Da avaliação" destaque="ao acompanhamento." id="como-e-feito" />

    <section class="secao escura" aria-labelledby="t-cuidados">
      <div class="envolve cuidados">
        <div>
          <p class="chapeu">Cuidados</p>
          <h2 class="titulo" id="t-cuidados">Depois da sessão, <em>tudo explicado.</em></h2>
          <ul class="lista">
            {
              t.cuidados.map((c) => (
                <li>
                  <span class="visto">
                    <Icone nome="certo" tamanho={15} traco={2} />
                  </span>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="aviso">
            <Icone nome="alerta" tamanho={22} />
            <span>Qualquer sinal diferente do esperado, fale com a clínica pelo WhatsApp, sem esperar a próxima sessão.</span>
          </p>
        </div>
        <div class="rt">
          <p class="rotulo">{r.nome ? rotuloResponsavel() : "Antes de começar"}</p>
          <p class="nome">{r.nome ?? "Avaliação personalizada"}</p>
          {r.nome && <p class="registro">{r.profissao} · {r.registro}</p>}
          <ul class="rt-garantias">
            <li>
              <Icone nome="prancheta" tamanho={18} />
              Avaliação do seu corpo, da sua rotina e do seu histórico de saúde
            </li>
            <li>
              <Icone nome="lista" tamanho={18} />
              Protocolo e número de sessões explicados antes de começar
            </li>
            <li>
              <Icone nome="conversa" tamanho={18} />
              Acompanhamento pelo WhatsApp entre as sessões
            </li>
          </ul>
        </div>
      </div>
    </section>

    <Duvidas perguntas={t.duvidas} titulo="Dúvidas sobre" destaque={`${t.nome}.`} mensagem={mensagem} />

    {
      relacionados.length > 0 && (
        <section class="secao branca" aria-labelledby="t-relacionados">
          <div class="envolve">
            <p class="chapeu">Veja também</p>
            <h2 class="titulo" id="t-relacionados">
              Outros cuidados <em>de {nomeDaCategoria[t.categoria].toLowerCase()}.</em>
            </h2>
            <ul class="relacionados">
              {relacionados.map((x) => (
                <li>
                  <CartaoTratamento nome={x.nome} resumo={x.resumo} href={`/tratamentos/${x.slug}/`} icone={x.icone} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <Chamada mensagem={mensagem} />
    <ZapFlutuante mensagem={mensagem} />
  </main>
  <Rodape />
</Base>

<style>
  .grade {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 80px;
    }
    .ficha {
      position: sticky;
      top: 32px;
      margin-top: 64px;
    }
  }
  .corpo {
    margin-top: 32px;
    display: grid;
    gap: 18px;
    max-width: 38em;
    color: var(--tinta-2);
  }
  .corpo .destaque {
    font-size: 20px;
    line-height: 1.55;
    color: var(--tinta);
  }
  .subtitulo {
    margin-top: 44px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--acento-texto);
  }
  .indicacoes {
    list-style: none;
    padding: 0;
    margin-top: 18px;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 600px) {
    .indicacoes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .indicacoes li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    font-weight: 550;
    line-height: 1.4;
  }
  .visto {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--escuro);
    color: var(--acento-claro);
  }

  .ficha {
    background: var(--branco);
    border: 1px solid var(--linha);
    border-top: 3px solid var(--acento);
    border-radius: var(--raio);
    padding: clamp(26px, 3.4vw, 36px);
    box-shadow: 0 30px 60px -40px color-mix(in oklab, var(--acento-texto) 55%, transparent);
  }
  .ficha h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--fonte-titulo);
    font-size: 28px;
    font-weight: 500;
  }
  .ficha h3 :global(svg) {
    color: var(--acento-texto);
  }
  .ficha dl {
    margin-top: 12px;
  }
  .ficha dl div {
    position: relative;
    display: grid;
    gap: 2px;
    min-height: 76px;
    padding: 16px 0 16px 58px;
    border-top: 1px solid var(--linha);
  }
  .ficha dl div:first-child {
    border-top: 0;
  }
  .ficha-icone {
    position: absolute;
    left: 0;
    top: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--suave);
    color: var(--acento-texto);
  }
  .ficha dt {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--acento-texto);
  }
  .ficha dd {
    font-size: 16px;
    line-height: 1.45;
  }
  .ficha .botao {
    margin-top: 12px;
    width: 100%;
  }

  .cuidados {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .cuidados {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 88px;
    }
  }
  .lista {
    list-style: none;
    padding: 0;
    margin-top: 40px;
    display: grid;
    gap: 14px;
    max-width: 40em;
  }
  .lista li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--claro);
  }
  .lista .visto {
    width: 26px;
    height: 26px;
    margin-top: 1px;
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--acento) 60%, transparent);
    color: var(--acento);
  }
  .aviso {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: var(--raio);
    background: color-mix(in oklab, var(--acento) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--acento) 28%, transparent);
    color: var(--claro);
    max-width: 40em;
  }
  .aviso :global(svg) {
    flex: none;
    color: var(--acento);
    margin-top: 2px;
  }

  .rt {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--acento) 40%, transparent);
    border-radius: var(--raio);
    padding: clamp(26px, 3.4vw, 34px);
    background: linear-gradient(160deg, var(--escuro-2), var(--escuro) 70%);
  }
  .rt .rotulo {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--acento);
  }
  .rt .nome {
    margin-top: 6px;
    font-family: var(--fonte-titulo);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--claro);
  }
  .rt .registro {
    margin-top: 2px;
    color: var(--acento-claro);
    font-weight: 500;
    font-size: 14.5px;
  }
  .rt-garantias {
    list-style: none;
    padding: 20px 0 0;
    margin-top: 22px;
    border-top: 1px solid color-mix(in oklab, var(--claro) 12%, transparent);
    display: grid;
    gap: 12px;
    font-size: 14.5px;
    color: var(--claro-2);
  }
  .rt-garantias li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .rt-garantias :global(svg) {
    flex: none;
    color: var(--acento);
    margin-top: 2px;
  }

  .relacionados {
    list-style: none;
    padding: 0;
    margin-top: 48px;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .relacionados {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .relacionados {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .relacionados li {
    display: grid;
    container-type: inline-size;
  }
  @media (min-width: 720px) and (max-width: 1079px) {
    .relacionados li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1080px) {
    .relacionados li:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
    .relacionados:has(> li:nth-child(2):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
